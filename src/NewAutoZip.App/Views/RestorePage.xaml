<UserControl x:Class="NewAutoZip.App.Views.RestorePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <!--
        三块比例分配：上面是包列表（挑哪个），中间是操作区（拿它干什么），
        下面是包内条目（里面有什么）。

        操作区是 Auto —— 它的高度由内容决定，不该跟着窗口伸缩；
        两个列表用比例行 + MinHeight，谁也压不死谁（理由同 FilesPage）。
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="3*" MinHeight="120" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="2*" MinHeight="90" />
        </Grid.RowDefinitions>

        <!-- ==================== 说明 ==================== -->
        <StackPanel Grid.Row="0" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource GroupTitle}" Margin="0,0,12,4" Text="恢复" />

                <ui:Button Margin="0,0,0,4"
                           Padding="8,2"
                           Command="{Binding RefreshRestoreCommand}"
                           Content="刷新列表"
                           FontSize="12"
                           ToolTip="重新扫描临时目录与云盘目录" />
            </StackPanel>

            <TextBlock Style="{StaticResource Hint}"
                       Margin="0,0,0,0"
                       Text="没试过恢复的备份不算备份。这里可以挑一个包，看看它里面有什么、用当前密码还解不解得开、或者把它整个解压出来。" />
            <TextBlock Style="{StaticResource Hint}"
                       Text="“演练”会把包解到临时目录逐个文件核对，核对完立刻删干净，不会在磁盘上留下东西，也不会动原来的包。" />
        </StackPanel>

        <!-- ==================== 可恢复的包 ==================== -->
        <ui:Card Grid.Row="1" Padding="2" Style="{StaticResource FillCard}">
            <Grid>
                <!--
                    选中行驱动下面整块操作区，所以这里用 SelectedItem 双向绑定
                    而不是每行塞一组按钮：命令是无参的 AsyncRelayCommand，
                    执行期间会自己置灰（见 ObservableObject）。
                -->
                <DataGrid ItemsSource="{Binding RestoreArchives}"
                          SelectedItem="{Binding SelectedArchive, Mode=TwoWay}"
                          Style="{StaticResource ReadOnlyGrid}"
                          Visibility="{Binding RestoreArchives.Count, Converter={StaticResource HasContent}}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Binding="{Binding FileName}" Header="压缩包" Width="*" />
                        <DataGridTextColumn Binding="{Binding SizeText}" Header="大小" Width="100" />
                        <DataGridTextColumn Binding="{Binding CreatedLocal, Converter={StaticResource Stamp}}" Header="生成时间" Width="165" />
                        <DataGridTextColumn Binding="{Binding Location}" Header="位置" Width="110" />
                        <!-- “清单”这一列决定了演练能验到什么程度，值得单独占一列 -->
                        <DataGridTextColumn Binding="{Binding ManifestText}" Header="清单" Width="60" />
                        <DataGridTextColumn Binding="{Binding Path}" Header="完整路径" Width="2*" />
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock Style="{StaticResource EmptyHint}"
                           Margin="0"
                           Text="临时目录和云盘目录里还没有压缩包。"
                           Visibility="{Binding RestoreArchives.Count, Converter={StaticResource HasContent}, ConverterParameter=invert}" />
            </Grid>
        </ui:Card>

        <!-- ==================== 操作 ==================== -->
        <ui:Card Grid.Row="2" Margin="0,12,0,0">
            <StackPanel>
                <TextBlock Style="{StaticResource Hint}"
                           Margin="0,0,0,10"
                           Foreground="{DynamicResource WarnText}"
                           Text="{Binding SelectedArchiveManifestWarning}"
                           Visibility="{Binding SelectedArchiveManifestWarning, Converter={StaticResource HasContent}}" />

                <StackPanel Style="{StaticResource FieldRow}">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="解压密码" />
                    <!--
                        默认填的是设置里存的那个密码，但必须可改：
                        换过密码之后，旧包只有旧密码解得开，而那种包恰恰最需要能恢复出来。
                    -->
                    <ui:PasswordBox Width="280"
                                    IsEnabled="{Binding RestoreIdle}"
                                    Password="{Binding RestorePassword, Mode=TwoWay}" />
                </StackPanel>

                <StackPanel Style="{StaticResource FieldRow}">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="解压到" />
                    <TextBox Width="380"
                             IsEnabled="{Binding RestoreIdle}"
                             Text="{Binding RestoreTarget, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <ui:Button Margin="8,0,0,0"
                               Click="OnPickTarget"
                               Content="浏览…"
                               IsEnabled="{Binding RestoreIdle}" />
                    <ui:Button Margin="8,0,0,0"
                               Command="{Binding OpenRestoreTargetCommand}"
                               Content="打开"
                               IsEnabled="{Binding HasRestoreTarget}"
                               ToolTip="在资源管理器里打开这个目录" />
                </StackPanel>

                <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                    <ui:Button Margin="0,0,8,0"
                               Command="{Binding ListArchiveCommand}"
                               Content="查看内容"
                               ToolTip="只读出包里有哪些文件，不解压" />

                    <!-- 演练是这一页的主操作：它回答“这个备份到底还能不能用” -->
                    <ui:Button Margin="0,0,8,0"
                               Appearance="Primary"
                               Command="{Binding DrillArchiveCommand}"
                               Content="恢复演练"
                               ToolTip="解出来逐个核对，核对完立即删除" />

                    <ui:Button Command="{Binding ExtractArchiveCommand}"
                               Content="解压到目录"
                               ToolTip="把整个包解压到上面指定的目录" />

                    <ui:ProgressRing Margin="12,0,0,0"
                                     Width="20"
                                     Height="20"
                                     IsIndeterminate="True"
                                     Visibility="{Binding RestoreBusy, Converter={StaticResource BoolVisibility}}" />
                </StackPanel>

                <!--
                    解压进度单独一条：7za 的 -bsp1 只在解压时给得出百分比，
                    演练和“查看内容”都没有进度可言，所以它跟着 RestoreBusy 显示、
                    值为 0 时也不会误导（那时条是空的）。
                -->
                <ProgressBar Height="4"
                             Margin="0,10,0,0"
                             Maximum="100"
                             Value="{Binding RestorePercent, Mode=OneWay}"
                             Visibility="{Binding RestoreBusy, Converter={StaticResource BoolVisibility}}" />

                <ui:InfoBar Margin="0,10,0,0"
                            IsClosable="False"
                            IsOpen="{Binding HasRestoreStatus, Mode=OneWay}"
                            Message="{Binding RestoreStatus}"
                            Severity="{Binding RestoreStatusKind}" />
            </StackPanel>
        </ui:Card>

        <!-- ==================== 包内条目 ==================== -->
        <ui:Card Grid.Row="3" Margin="0,12,0,0" Padding="2" Style="{StaticResource FillCard}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!--
                    条目数绑 .Count 而不是视图模型里的一个字符串属性：
                    ObservableCollection 增删时会自己为 Count 发通知，
                    换成属性就得记着在每个增删点手动 Raise 一次 —— 漏一处就是数字不更新。
                -->
                <TextBlock Grid.Row="0"
                           Margin="8,6,8,6"
                           FontSize="12"
                           Foreground="{DynamicResource MutedText}"
                           Visibility="{Binding RestoreEntries.Count, Converter={StaticResource HasContent}}">
                    <Run Text="包内共" />
                    <Run Text="{Binding RestoreEntries.Count, Mode=OneWay}" />
                    <Run Text="个条目" />
                </TextBlock>

                <Grid Grid.Row="1">
                    <DataGrid ItemsSource="{Binding RestoreEntries}"
                              Style="{StaticResource ReadOnlyGrid}"
                              Visibility="{Binding RestoreEntries.Count, Converter={StaticResource HasContent}}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Binding="{Binding Path}" Header="包内路径" Width="*" />
                            <!-- ArchiveEntry 是 Core 的原始记录，没有 SizeText，所以这里过一道转换器 -->
                            <DataGridTextColumn Binding="{Binding Size, Converter={StaticResource ByteSize}}" Header="大小" Width="100" />
                            <DataGridTextColumn Binding="{Binding Modified, Converter={StaticResource Stamp}}" Header="修改时间" Width="165" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Style="{StaticResource EmptyHint}"
                               Margin="0"
                               Text="选一个包，点“查看内容”就能看到里面有哪些文件。"
                               Visibility="{Binding RestoreEntries.Count, Converter={StaticResource HasContent}, ConverterParameter=invert}" />
                </Grid>
            </Grid>
        </ui:Card>
    </Grid>
</UserControl>
