<ui:FluentWindow x:Class="NewAutoZip.App.Views.BootTaskWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="注册开机自启"
                 Width="560"
                 SizeToContent="Height"
                 ExtendsContentIntoTitleBar="True"
                 ResizeMode="NoResize"
                 ShowInTaskbar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 WindowStartupLocation="CenterScreen">

    <!--
        开机自启要 Windows 密码：任务计划程序得在没人登录时以这个账户登录，
        才能跑起程序、并解开 DPAPI 加密的压缩密码。

        这个窗口有两种出身：已经是管理员时由主界面直接弹出；不是管理员时，
        主界面以「以管理员身份运行」拉起本程序的另一个进程（带 boot-task register 参数），
        由那个进程弹出它。两种情况下密码都只在弹出它的那个进程里走一趟。
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0"
                     Title="注册开机自启"
                     ShowMaximize="False"
                     ShowMinimize="False">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Assets/app.ico" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <StackPanel Grid.Row="1" Margin="24,8,24,20">

            <TextBlock FontSize="13"
                       TextWrapping="Wrap"
                       Text="开机后，Windows 任务计划程序会以下面这个账户在后台启动 AutoZip 并自动开始备份 —— 不需要任何人登录桌面，和数据库服务一样。" />

            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="96" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0"
                           VerticalAlignment="Center"
                           FontSize="12"
                           Foreground="{DynamicResource MutedText}"
                           Text="运行账户" />
                <TextBox x:Name="AccountText"
                         Grid.Row="0" Grid.Column="1"
                         Padding="0"
                         Background="Transparent"
                         BorderThickness="0"
                         FontSize="13"
                         IsReadOnly="True" />

                <TextBlock Grid.Row="1" Grid.Column="0"
                           Margin="0,8,0,0"
                           VerticalAlignment="Center"
                           FontSize="12"
                           Foreground="{DynamicResource MutedText}"
                           Text="程序" />
                <TextBox x:Name="ExeText"
                         Grid.Row="1" Grid.Column="1"
                         Margin="0,8,0,0"
                         Padding="0"
                         Background="Transparent"
                         BorderThickness="0"
                         FontSize="12"
                         IsReadOnly="True"
                         TextWrapping="Wrap" />

                <TextBlock Grid.Row="2" Grid.Column="0"
                           Margin="0,14,0,0"
                           VerticalAlignment="Center"
                           FontSize="12"
                           Foreground="{DynamicResource MutedText}"
                           Text="Windows 密码" />
                <ui:PasswordBox x:Name="PasswordInput"
                                Grid.Row="2" Grid.Column="1"
                                Margin="0,14,0,0"
                                PlaceholderText="这个账户登录 Windows 用的密码" />
            </Grid>

            <TextBlock Margin="0,12,0,0"
                       FontSize="12"
                       Foreground="{DynamicResource MutedText}"
                       TextWrapping="Wrap"
                       Text="密码只交给 Windows 任务计划程序，由系统加密保管，AutoZip 自己不保存它。以后改了 Windows 密码，回设置页点「重新注册」再填一次即可。用微软账户登录的电脑，填微软账户的密码（不是 PIN）。" />

            <TextBlock x:Name="ErrorText"
                       Margin="0,12,0,0"
                       FontSize="12"
                       Foreground="{DynamicResource ErrorText}"
                       TextWrapping="Wrap"
                       Visibility="Collapsed" />

            <StackPanel Margin="0,18,0,0"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal">
                <ui:Button x:Name="RegisterButton"
                           MinWidth="96"
                           Appearance="Primary"
                           Click="OnRegister"
                           Content="注册"
                           IsDefault="True" />
                <ui:Button x:Name="CancelButton"
                           MinWidth="96"
                           Margin="8,0,0,0"
                           Click="OnCancel"
                           Content="取消"
                           IsCancel="True" />
            </StackPanel>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
