<UserControl x:Class="NewAutoZip.App.Views.QuarantinePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Style="{StaticResource GroupTitle}" Text="隔离区" />
            <TextBlock Style="{StaticResource Hint}"
                       Margin="0,0,0,0"
                       Text="同一批文件连续打包失败达到上限后会被移到这里，程序随即停止对它重试。这是防止“失败 → 重试 → 又失败”把磁盘填满的最后一道闸门 —— 旧版没有这道闸门，一次失败就会每个扫描周期产生一个完整压缩包，直到磁盘满。" />
            <TextBlock Style="{StaticResource Hint}"
                       Foreground="{DynamicResource WarnText}"
                       Text="这里有内容意味着这些文件还没有被备份。请先看清失败原因，处理掉根本问题，再点“重新排队”。" />
        </StackPanel>

        <Grid Grid.Row="1">
            <!--
                用 ItemsControl 而不是 DataGrid：每个批次要展示文件清单和两个按钮，
                这种"卡片列表"的结构塞进表格单元格里会很难读。
            -->
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding Quarantines.Count, Converter={StaticResource HasContent}}">
                <ItemsControl ItemsSource="{Binding Quarantines}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ui:Card Margin="0,0,0,10">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock FontWeight="SemiBold" FontSize="14">
                                                    <Run Text="{Binding FileCount, Mode=OneWay}" />
                                                    <Run Text="个文件 ·" />
                                                    <Run Text="{Binding SizeText, Mode=OneWay}" />
                                                </TextBlock>

                                                <TextBlock Margin="10,0,0,0"
                                                           VerticalAlignment="Center"
                                                           FontSize="12"
                                                           Foreground="{DynamicResource MutedText}">
                                                    <Run Text="已尝试" />
                                                    <Run Text="{Binding Attempts, Mode=OneWay}" />
                                                    <Run Text="次 ·" />
                                                    <Run Text="{Binding QuarantinedLocal, Mode=OneWay, Converter={StaticResource Stamp}}" />
                                                    <Run Text="进入隔离" />
                                                </TextBlock>
                                            </StackPanel>

                                            <TextBlock Margin="0,6,0,0"
                                                       Foreground="{DynamicResource ErrorText}"
                                                       TextWrapping="Wrap"
                                                       Text="{Binding Reason}" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <ui:Button Margin="0,0,8,0"
                                                       Appearance="Primary"
                                                       Content="重新排队"
                                                       ToolTip="把这批文件放回处理队列，重新计数重试"
                                                       Command="{Binding DataContext.RequeueQuarantineCommand,
                                                                         RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                       CommandParameter="{Binding Id}" />

                                            <!--
                                                这颗按钮用 Danger（红）而不是 Primary：点下去等于承认
                                                这批文件不备份了。颜色是"带颜色的按钮"，但不能和主操作一个色。
                                            -->
                                            <ui:Button Appearance="Danger"
                                                       Content="忽略"
                                                       ToolTip="放弃这批文件，从隔离区移除。文件本身不会被删除"
                                                       Command="{Binding DataContext.DiscardQuarantineCommand,
                                                                         RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                       CommandParameter="{Binding Id}" />
                                        </StackPanel>
                                    </Grid>

                                    <!-- 文件清单默认收起：一个批次可能有几百个文件 -->
                                    <ui:CardExpander Margin="0,10,0,0" Header="查看文件清单">
                                        <ItemsControl ItemsSource="{Binding Files}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock FontFamily="Consolas, Cascadia Mono, monospace"
                                                               FontSize="12"
                                                               Text="{Binding}"
                                                               TextTrimming="CharacterEllipsis" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ui:CardExpander>
                                </StackPanel>
                            </ui:Card>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <StackPanel VerticalAlignment="Center"
                        Visibility="{Binding Quarantines.Count, Converter={StaticResource HasContent}, ConverterParameter=invert}">
                <TextBlock HorizontalAlignment="Center"
                           FontFamily="{StaticResource IconFont}"
                           FontSize="40"
                           Foreground="{DynamicResource DotOk}"
                           Text="&#xE73E;" />
                <TextBlock Style="{StaticResource EmptyHint}"
                           Margin="0,12,0,0"
                           Text="隔离区是空的 —— 没有反复失败的批次。" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
