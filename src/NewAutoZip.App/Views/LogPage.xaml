<UserControl x:Class="NewAutoZip.App.Views.LogPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="240" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ==================== 工具条 ==================== -->
        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center" Orientation="Horizontal">
                <!--
                    倒序默认开着：出事时第一眼要看的是「最后发生了什么」。
                    顺着排就得先滚到底，而日志一直在往里进，滚到底这个动作永远做不完。
                -->
                <CheckBox Content="最新的在最上面"
                          IsChecked="{Binding NewestLogFirst, Mode=TwoWay}"
                          VerticalAlignment="Center" />

                <CheckBox Margin="16,0,0,0"
                          Content="自动跟随最新"
                          IsChecked="{Binding AutoScrollLog, Mode=TwoWay}"
                          VerticalAlignment="Center" />

                <TextBlock Margin="16,0,0,0"
                           VerticalAlignment="Center"
                           FontSize="12"
                           Foreground="{DynamicResource WarnText}"
                           Text="{Binding DroppedLogText}" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <ui:Button Margin="0,0,8,0" Appearance="Primary" Command="{Binding CopyLogCommand}" Content="复制" />
                <ui:Button Margin="0,0,8,0" Appearance="Primary" Command="{Binding ClearLogCommand}" Content="清空显示" />
                <ui:Button Margin="0,0,8,0" Appearance="Primary" Command="{Binding OpenLogFileCommand}" Content="打开日志文件" />
                <ui:Button Appearance="Primary" Command="{Binding OpenLogFolderCommand}" Content="日志目录" />
            </StackPanel>
        </Grid>

        <!-- ==================== 日志列表 ====================
             虚拟化 + 2000 行上限。旧版只有 12 行，而每个文件每轮都推一条"写入中"，
             20 个文件就把这 12 行刷满，真正要看的错误信息一秒钟就被顶掉了。

             FillCard 不是多余的：ui:Card 默认把自己和内容都钉在顶部，
             不套这个样式的话，行给了 629 像素、卡片只用 82 像素，日志区缩成三四行。
        -->
        <ui:Card Grid.Row="1" Padding="4" Style="{StaticResource FillCard}">
            <ListBox x:Name="LogList"
                     Background="Transparent"
                     BorderThickness="0"
                     ItemsSource="{Binding LogLines}"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem"
                           BasedOn="{StaticResource SelectableListBoxItem}">
                        <Setter Property="Padding" Value="6,1" />
                        <Setter Property="MinHeight" Value="0" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListBox.ItemContainerStyle>

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <!--
                                时间戳带年月日（走 StampConverter，和界面上其它"某件事发生在什么时候"
                                共用同一份格式定义）。
                                原来是只显示 HH:mm:ss 的 TimeOfDay：这个程序常驻后台跑几个月，
                                日志页又只留最近 2000 行，跨年之后光看 "18:09:31" 完全分不清
                                是今天还是上周。列宽 140 是按 "yyyy-MM-dd HH:mm:ss" 19 个字符
                                在 12 号等宽字体下的实际宽度定的（Consolas 约 126px、
                                Cascadia Mono 约 137px），再窄就会被截断成 "2026-09-03 15:1…"。
                            -->
                            <TextBlock Width="140"
                                       FontFamily="Consolas, Cascadia Mono, monospace"
                                       FontSize="12"
                                       Foreground="{DynamicResource MutedText}"
                                       Text="{Binding TimestampLocal, Converter={StaticResource Stamp}}" />

                            <!--
                                级别只用颜色区分，不占一列文字宽度。

                                颜色走 DataTrigger + DynamicResource 而不是"级别→画刷"转换器：
                                转换器只在 Level 变化时求值，而 Level 是每行固定不变的，
                                切主题后已经画出来的几百行会全部停在上一个主题的颜色上 ——
                                浅色主题下 Info 是白底浅灰，整片日志看不见。
                            -->
                            <TextBlock FontFamily="Consolas, Cascadia Mono, monospace"
                                       FontSize="12"
                                       Text="{Binding Message}"
                                       TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource LogInfo}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Level}" Value="Debug">
                                                <Setter Property="Foreground" Value="{DynamicResource LogDebug}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Level}" Value="Warn">
                                                <Setter Property="Foreground" Value="{DynamicResource LogWarn}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Level}" Value="Error">
                                                <Setter Property="Foreground" Value="{DynamicResource LogError}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </ui:Card>

        <TextBlock Grid.Row="2"
                   Style="{StaticResource Hint}"
                   Text="这里显示的是按“日志级别”过滤后的内容，级别在设置页调整，最多留最近 2000 行。日志文件里始终是完整的、按时间正序，单个文件写满 10 MB 自动轮转、连当前文件共留 3 个（占盘最多 30 MB）；密码与 Webhook 地址已脱敏 —— 旧版会把 PASSWORD=xxx 明文写进日志，而日志和压缩包放在同一台机器上，等于加密白做了。" />
    </Grid>
</UserControl>
