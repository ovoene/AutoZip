<Project Sdk="Microsoft.NET.Sdk">

  <!--
    界面层。只做三件事：把配置读给引擎、把引擎快照画出来、把用户点击转成引擎调用。
    所有业务逻辑都在 NewAutoZip.Core 里 —— 那是能被单元测试驱动的部分。
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>NewAutoZip.App</RootNamespace>

    <!--
        产出的可执行文件名 = 程序名。命名空间与项目文件名沿用 NewAutoZip.* ——
        那是代码内部的组织方式，改了只会让 git 历史断掉，对用户没有任何区别。
    -->
    <AssemblyName>AutoZip</AssemblyName>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <IsPackable>false</IsPackable>

    <!-- 未捕获异常已经在 App.xaml.cs 里三处兜底，不需要 WPF 默认的崩溃对话框 -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WPF-UI" Version="4.3.0" />
    <PackageReference Include="WPF-UI.Tray" Version="4.3.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NewAutoZip.Core\NewAutoZip.Core.csproj" />
  </ItemGroup>

  <!--
    随程序携带的 7-Zip 控制台版。
    旧版硬编码 C:\Program Files\7-Zip\7z.exe，目标机没装 7-Zip 时 Run() 直接返回，
    但界面上"● 运行中"的绿灯还亮着 —— 界面在撒谎。带着走就没有这个问题。

    ExcludeFromSingleFile 是必须的：单文件发布默认会把 Content 一起塞进 exe 的
    bundle 里，而 bundle 里的东西不是磁盘上的文件，CreateProcess 根本启动不了它
    （只有 IncludeAllContentForSelfExtract 才会解包，那又会让每次启动都往临时目录
    释放 77 MB）。这里要的是 7za.exe 作为一个真实文件躺在 exe 旁边。
    publish.cmd 会在发布后检查它确实存在。
  -->
  <ItemGroup>
    <Content Include="tools\7za.exe">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

</Project>
